# --- Database (matches docker-compose.yml) ---
DATABASE_URL="postgresql://mice:mystics@localhost:5433/mice_mystics?schema=public"

# --- Server ---
PORT=3001
# Public URL of the app. In dev the client proxies /api, so auth links point at the Vite server
APP_URL="http://localhost:5173"

# --- Better Auth ---
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-long-random-string"

# --- Email (Mailpit in dev: inbox at http://localhost:8025) ---
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="Mice & Mystics <no-reply@mice-mystics.local>"

# --- Google sign-in (optional; the button is hidden when unset) ---
# Create at https://console.cloud.google.com/apis/credentials (see README)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
